APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
WEBHOOK_LOG_STACK=webhook_daily
WEBHOOK_LOG_LEVEL=info
WEBHOOK_LOG_DAYS=14
LOG_VIEWER_ENABLED=true
LOG_VIEWER_TIMEZONE=Asia/Taipei
LOG_VIEWER_CACHE_DRIVER=file

DB_CONNECTION=mysql
DB_COLLATION=utf8mb4_unicode_ci
DB_HOST=host.docker.internal
DB_PORT=33070
DB_DATABASE=blog
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=63800

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=amanda-blog
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_REPLY_TOKEN_SAFE_WINDOW_SECONDS=45
# Must produce a publicly accessible HTTPS URL when used by LINE.
LINE_SCHEDULE_IMAGE_DISK=s3
LINE_SCHEDULE_IMAGE_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
LINE_SCHEDULE_IMAGE_RETENTION_DAYS=7

# bo3.gg schedule source
BO3_BASE_URL=https://bo3.gg
BO3_API_URL=https://api.bo3.gg/api/v1
BO3_CACHE_SECONDS=300
BO3_H2H_CACHE_SECONDS=300
BO3_TIMEOUT_SECONDS=10
BO3_TIMEZONE=Asia/Taipei

# Optional odds provider key (not required for bo3.gg schedules)
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.odds-api.io/v3
# Leave blank to use the bookmakers selected in your Odds-API.io account.
ODDS_API_BOOKMAKERS=
ODDS_API_BOOKMAKER_PRIORITY=Stake,Bet365
ODDS_API_CACHE_SECONDS=60
ODDS_API_TIMEOUT_SECONDS=10
