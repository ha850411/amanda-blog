COMPOSE_PROJECT_NAME=amanda-blog
PHP_VERSION=8.4
COMPOSER_VERSION=2
# app
APP_IMAGE=ghcr.io/ha850411/amanda-blog-runtime
# `make` derives RUNTIME_IMAGE_TAG from the Dockerfile and base image inputs.
COMPOSER_CACHE_VOLUME=amanda-blog-composer-cache
RUNTIME_REGISTRY_IMAGE=ghcr.io/ha850411/amanda-blog-runtime
BUILD_CACHE_IMAGE=ghcr.io/ha850411/amanda-blog-runtime:buildcache-php8.4
# CI must inject GHCR_TOKEN from its secret store; never save the token here.
GHCR_USERNAME=ha850411
APP_PORT=8900
# network gateway
NGINX_NAME=amanda-blog-nginx
NETWORK_NAME=amanda-blog-web-network
# MySQL 單元測試連接埠
TEST_MYSQL_PORT=3387
